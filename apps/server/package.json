    "@helyx/db": "workspace:*",
    "@helyx/protocol": "workspace:*",
    "@helyx/shared": "workspace:*",
    "express": "4.22.3",
    "pino": "9.14.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "pino-pretty": "13.2.0",
    "tsup": "8.5.1"
  }
}
