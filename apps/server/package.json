{
  "name": "@helyx/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
