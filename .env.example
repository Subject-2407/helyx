# Copy to `.env` and adjust. Every value below is a safe local-development placeholder;
# none of them is a real secret. On a server, keep `.env` readable by its owner only (chmod 600).
# An empty value (`KEY=`) means "not set" and the built-in default applies.

# --- Runtime -----------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# game | worker
ROLE=game
# Defaults to the host name.
SERVER_ID=
PORT=2567
WORKER_HEALTH_PORT=2568
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
METRICS_ENABLED=true

# --- Public address ----------------------------------------------------------------------
# The URL players open. Local dev uses the Vite server; for the full stack behind Caddy use
# https://localhost; in production use the real https origin.
PUBLIC_URL=http://localhost:5173

# --- Database and cache ------------------------------------------------------------------
# These match the dev services in infra/docker-compose.dev.yml. The full-stack compose file
# overrides both with the internal service addresses.
DATABASE_URL=postgres://helyx:helyx@localhost:5432/helyx
DATABASE_POOL_MAX=20
REDIS_URL=redis://localhost:6379

# --- Authentication ----------------------------------------------------------------------
# At least 32 characters. This development value is refused in production; generate a real one
# with: openssl rand -base64 48
BETTER_AUTH_SECRET=helyx-local-development-secret-not-for-production
# Defaults to PUBLIC_URL.
BETTER_AUTH_URL=
# OAuth providers are disabled while their id and secret are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# smtp(s)://user:pass@host:port. Empty in development: emails are written to the log instead.
SMTP_URL=
SMTP_FROM=
# Comma-separated; verified accounts with these emails become administrators at login.
GM_BOOTSTRAP_EMAILS=

# --- Content -----------------------------------------------------------------------------
# Built content bundle file; empty uses the build output in the repository.
CONTENT_BUNDLE_PATH=
# Directory of the server-only content bundle; empty uses the build output in the repository.
LISTENER_BUNDLE_PATH=

# --- World and capacity ------------------------------------------------------------------
AREA_CHANNEL_MAX=80
PLACE_CHANNEL_MAX=40
MAX_CHANNELS_PER_MAP=10
MAX_CCU=250
# Seconds between persistence flushes (10-30).
FLUSH_INTERVAL_S=15
# Origin of the in-game calendar, in Unix milliseconds (2026-01-01T00:00:00Z).
CLOCK_EPOCH_MS=1767225600000
SEASON_LENGTH_DAYS=7
GUEST_PURGE_DAYS=90
# true lets only staff accounts join.
MAINTENANCE_MODE=false
# Multiplies every rate limit; tests raise it.
RATE_LIMIT_SCALE=1.0

# --- Reverse proxy (Caddy) ---------------------------------------------------------------
# localhost gets a locally trusted certificate; a public domain gets one over ACME.
DOMAIN=localhost
# Contact for certificate expiry notices; use a real mailbox in production.
ACME_EMAIL=dev@example.com

# --- PostgreSQL container ----------------------------------------------------------------
POSTGRES_USER=helyx
# Keep it URL-safe: the full-stack compose file builds the connection URL from it.
POSTGRES_PASSWORD=helyx
POSTGRES_DB=helyx

# --- Container images --------------------------------------------------------------------
# Tag for the locally built server and Caddy images (a release uses the commit id).
IMAGE_TAG=local

# --- Client build (public: these end up in the browser bundle, never put secrets here) ----
VITE_PUBLIC_URL=http://localhost:5173
VITE_ENABLE_LAGSIM=false

# --- Optional asset generators (tools only) ----------------------------------------------
# none | mock | openai | stability | replicate | comfyui
IMAGEGEN_PROVIDER=none
IMAGEGEN_API_KEY=
IMAGEGEN_MODEL=
IMAGEGEN_ENDPOINT=
IMAGEGEN_CONCURRENCY=2
IMAGEGEN_MAX_COST_USD=5
IMAGEGEN_CANDIDATES=4
IMAGEGEN_TIMEOUT_S=120
AUDIOGEN_PROVIDER=none
AUDIOGEN_API_KEY=
AUDIOGEN_MODEL=
AUDIOGEN_ENDPOINT=
AUDIOGEN_MAX_COST_USD=5
