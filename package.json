{
  "name": "helyx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --coverage",
    "test:e2e": "pnpm --filter @helyx/client run e2e",
    "lint": "eslint . --max-warnings 0 && prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore.local && pnpm run depcruise && pnpm run guard tracked",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore.local",
    "depcruise": "depcruise apps packages tools --config .dependency-cruiser.cjs",
    "guard": "tsx tools/repo-guard/src/cli.ts",
    "content:validate": "pnpm --filter @helyx/content-cli run validate",
    "assets:validate": "pnpm --filter @helyx/asset-pipeline run validate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@helyx/config": "workspace:*",
    "@helyx/repo-guard": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "3.2.7",
    "dependency-cruiser": "16.10.4",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
